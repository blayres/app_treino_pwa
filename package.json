{
  "name": "app_treino",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web && node scripts/inject-meta.js",
    "import:exercises": "ts-node --project tsconfig.json scripts/importExerciseDb.ts",
    "link:exercises": "ts-node --skip-project scripts/linkExercises.ts",
    "link:gifs": "node --env-file=.env scripts/linkFreeExerciseGifs.ts",
    "prepare": "husky",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/{services,utils,store}/**/*.ts' --collectCoverageFrom='src/{components,screens,hooks}/**/*.tsx'",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@supabase/supabase-js": "^2.103.1",
    "expo": "54.0.34",
    "expo-asset": "12.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-web": "^0.21.0",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.2.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
